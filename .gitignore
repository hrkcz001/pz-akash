*/deployment.yaml
__pycache__/
*.pyc
*-logs-*.txt
*.log
pz-controller/pz-saves/

# v2 scratch area. The reports and the runner scripts are worth keeping; the
# compiled binary, the gate's throwaway git repositories and its captured output
# are regenerated by running the gate again.
scratch/pzctl.exe
scratch/gate/
scratch/gate6/
scratch/gate.txt

# The step 7 gallery is rendered output, not source: gate7.ps1 deletes and
# rebuilds it, so a page that stopped being produced disappears rather than
# lingering in a diff.
scratch/gallery/

# Captured live state: which dseq is running where, right now. Regenerated by
# asking the API and wrong the moment anything is redeployed, so committing it
# would put a stale answer somewhere people look for a current one.
scratch/prod-*.json

# SteamCMD depot downloads.
depots/

# The saves, when they are checked out into the build context. CI puts them there
# with a second actions/checkout, and a local `docker build --target controller`
# needs the same layout. Committing that checkout would nest one repository's
# contents inside another.
/pz-saves/
